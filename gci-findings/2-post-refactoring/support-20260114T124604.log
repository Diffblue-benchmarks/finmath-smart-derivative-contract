    ClientEndpointConfig clientEndpointConfig =
        extensionsResult
            .preferredSubprotocols(new ArrayList<>())
            .sslContext(SSLContext.getDefault())
            .build();

    WsSession userSession =
        new WsSession(
            clientEndpointHolder,
            wsRemoteEndpoint,
            wsWebSocketContainer,
            negotiatedExtensions,
            "Sub Protocol",
            pathParameters,
            true,
            clientEndpointConfig);

    // Act
    webSocketClientEndpoint.onClose(
        userSession, new CloseReason(mock(CloseCode.class), "Just cause"));
  }
}

